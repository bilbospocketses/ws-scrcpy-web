# Written BEFORE the Dockerfile, deliberately. `COPY . .` with no .dockerignore
# sends node_modules/, dist/, target/, Releases/, publish/, test-results/ and the
# whole .git history to the daemon. docs/traps.md records a 9.59 GB context
# transfer that "looks identical to a hang: no output, and low CPU because the
# work is I/O-bound".
.git
.github
node_modules
dist
build
target
publish
Releases
spike
test-results
playwright-report
blob-report

# seed/ is excluded DELIBERATELY: the build stage regenerates it for the target
# arch. Shipping the host's seed/node/node.exe into a Linux image is the exact
# class of mistake this line prevents.
seed

# dependencies/ is the mutable runtime state that lives on the /data volume, not
# something the image carries.
dependencies

*.log
docs
.vs

# .superpowers/ is the subagent-driven-development workspace: ledgers, task
# briefs, implementer reports and review diffs. It is gitignored, but this is a
# SEPARATE list -- gitignore has no bearing on the build context. Without this
# line every write to that directory invalidates the `COPY . .` layer and forces
# a full webpack rebuild inside the build stage. It never reached the published
# image either way (the runtime stage copies named paths out of build, not the
# whole tree), so this is build time, not exposure.
.superpowers
